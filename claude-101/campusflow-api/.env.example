# Copia este archivo a .env y ajusta según tu entorno.

# SQLite por defecto: cero configuración, ideal para las primeras sesiones del curso.
DATABASE_URL=sqlite:///./campusflow.db

# Cuando lleguemos al bloque de RAG, descomenta esta línea y comenta la de arriba
# (requiere PostgreSQL 16 con la extensión pgvector ya creada).
# DATABASE_URL=postgresql+psycopg://campusflow:campusflow@localhost:5432/campusflow
